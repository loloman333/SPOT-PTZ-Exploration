<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base">

    <!-- Materials -->
    <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>

    <!-- Properties -->
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_length" value="0.45"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.15"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_offset_z" value="0.0"/>
    <xacro:property name="wheel_x_offset" value="0.0"/>
    <xacro:property name="caster_radius" value="0.05"/>

    <!-- Base Link (root) -->
    <link name="base_link">
        <visual>
            <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        </collision>
        <inertial>
            <mass value="35.0"/>
            <inertia ixx="0.85" ixy="0" ixz="0" iyy="1.17" iyz="0" izz="1.78"/>
        </inertial>
    </link>

    <!-- Footprint below base_link -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- Wheel Macro -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="dark_grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <inertial>
                <mass value="2.0"/>
                <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect*wheel_x_offset} ${y_reflect*(base_width/2+wheel_width/2)} ${-wheel_offset_z}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    <!-- Drive wheels centered on base_link -->
    <xacro:wheel prefix="left"  x_reflect="1"  y_reflect="1" />
    <xacro:wheel prefix="right" x_reflect="1"  y_reflect="-1" />

    <!-- Passive casters to prevent rocking -->
    <link name="front_caster">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><sphere radius="${caster_radius}"/></geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <gazebo reference="front_caster">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>

    <link name="rear_caster">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><sphere radius="${caster_radius}"/></geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <gazebo reference="rear_caster">
        <mu1>0.6</mu1>
        <mu2>0.6</mu2>
    </gazebo>

    <joint name="front_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_caster"/>
        <origin xyz="${base_length/2 - caster_radius} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>

    <joint name="rear_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_caster"/>
        <origin xyz="${-base_length/2 + caster_radius} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>

    <gazebo>
        <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
            <topic>cmd_vel</topic>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!-- Kinematics -->
            <wheel_separation>${base_width + wheel_width}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <!-- Limits & Output -->
            <max_wheel_torque>50</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>

            <!-- Odometry -->
            <!-- <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <tf_topic>tf</tf_topic>
            <child_frame_id>base_link</child_frame_id> -->
            <publish_odom_tf>false</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
            
            <!-- <update_rate>30</update_rate> -->
        </plugin>

        <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            
            <!-- This tells the plugin to publish the TF transform directly -->
            <publish_odom_tf>true</publish_odom_tf>
            
            <!-- The topic where the nav_msgs/Odometry will be published -->
            <tf_topic>tf</tf_topic>
            <odom_topic>odom</odom_topic>
            
            <!-- 0 = 3D (X,Y,Z,R,P,Y), 2 = 2D (X,Y,Yaw) -->
            <dimensions>2</dimensions> 
        </plugin>

        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <!-- <update_rate>30</update_rate> -->
        </plugin>
    </gazebo>

</robot>